{
  "name": "petri-net-editor",
  "type": "module",
  "version": "0.3.3",
  "private": true,
  "packageManager": "pnpm@12.3.0",
  "description": "Interactive, browser-based Petri net editor with simulation and analysis tooling",
  "author": {
    "name": "nimec01"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/nimec01/petri-net-editor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimec01/petri-net-editor.git"
  },
  "bugs": {
    "url": "https://github.com/nimec01/petri-net-editor/issues"
  },
  "keywords": [
    "petri-net",
    "petri-nets",
    "editor",
    "simulation",
    "analysis",
    "nuxt",
    "vue",
    "cytoscape"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "wrangler --cwd .output dev",
    "postinstall": "nuxt prepare",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit && vue-tsc --noEmit -p tests/tsconfig.json && vue-tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.8",
    "cytoscape": "3.34.2",
    "cytoscape-dagre": "4.0.1",
    "dagre": "0.8.5",
    "daisyui": "5.7.27",
    "fflate": "0.8.3",
    "katex": "0.18.5",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@changesets/cli": "3.0.1",
    "@iconify/json": "2.2.525",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.1.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11",
    "wrangler": "4.128.0"
  }
}
