{
  "name": "petri-net-editor",
  "type": "module",
  "version": "0.3.4",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "description": "Interactive, browser-based Petri net editor with simulation and analysis tooling",
  "author": {
    "name": "nimec01"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/nimec01/petri-net-editor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimec01/petri-net-editor.git"
  },
  "bugs": {
    "url": "https://github.com/nimec01/petri-net-editor/issues"
  },
  "keywords": [
    "petri-net",
    "petri-nets",
    "editor",
    "simulation",
    "analysis",
    "nuxt",
    "vue",
    "cytoscape"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "wrangler --cwd .output dev",
    "postinstall": "nuxt prepare",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit && vue-tsc --noEmit -p tests/tsconfig.json && vue-tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/katex": "0.16.8",
    "cytoscape": "3.35.0",
    "cytoscape-dagre": "4.1.0",
    "dagre": "0.8.5",
    "daisyui": "5.7.50",
    "fflate": "0.8.3",
    "katex": "0.19.1",
    "nuxt": "4.6.4",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@changesets/cli": "3.0.3",
    "@iconify/json": "2.2.555",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "unplugin-icons": "24.0.0",
    "unplugin-vue-components": "32.1.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "wrangler": "4.160.0"
  }
}
