{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:recommended",
    "schedule:automergeDaily",
    ":label(dependencies)"
  ],
  "enabledManagers": [
    "npm",
    "devcontainer",
    "docker-compose",
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": ">=1.0.0",
      "groupName": "all patch updates",
      "groupSlug": "all-patch",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchPackageNames": [
        "docker/**"
      ],
      "groupName": "docker",
      "groupSlug": "docker"
    },
    {
      "matchPackageNames": [
        "pnpm"
      ],
      "enabled": false
    }
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automergeType": "pr",
  "gitIgnoredAuthors": [
    "github-actions@github.com",
    "24428341+nimec01@users.noreply.github.com",
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  "automergeSchedule": [
    "* 0-3 * * 0"
  ]
}
